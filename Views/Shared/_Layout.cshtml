<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - UTTT Ecosistema A.U.R.A.</title>

    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <!-- UTTT Institutional Theme CSS -->
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <!-- Navbar Institucional UTTT -->
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark navbar-uttt py-2">
            <div class="container-fluid px-lg-5">
                <a class="navbar-brand d-flex align-items-center gap-2" href="/">
                    <div class="bg-white text-dark rounded-circle d-flex align-items-center justify-content-center fw-bold shadow-sm" style="width: 40px; height: 40px;">
                        <span class="text-uttt-green fs-5">UT</span>
                    </div>
                    <div class="d-flex flex-column">
                        <span class="fw-bold leading-tight" style="font-size: 1.05rem;">UTTT — A.U.R.A.</span>
                        <span class="small text-white-50" style="font-size: 0.72rem;">Univ. Tecnológica de Tula-Tepeji</span>
                    </div>
                </a>

                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarUtttContent" aria-controls="navbarUtttContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarUtttContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-4 gap-1">
                        <li class="nav-item">
                            <a class="nav-link" href="/Estudiante/Dashboard">
                                <i class="bi bi-person-workspace me-1"></i> Estudiante
                            </a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-broadcast me-1"></i> Docente
                            </a>
                            <ul class="dropdown-menu border-0 shadow">
                                <li><a class="dropdown-item" href="/Docente/MiDia"><i class="bi bi-calendar-day me-2"></i>Modo "Mi Día" (Pase de Lista)</a></li>
                                <li><a class="dropdown-item" href="/Docente/MisGrupos"><i class="bi bi-collection me-2"></i>Modo "Mis Grupos" (Listas Excel)</a></li>
                            </ul>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/Tutor/MisTutorados">
                                <i class="bi bi-people-fill me-1"></i> Tutor
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/Secretaria/Dashboard">
                                <i class="bi bi-building-gear me-1"></i> Secretaría
                            </a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-shield-lock-fill me-1"></i> Director
                            </a>
                            <ul class="dropdown-menu border-0 shadow">
                                <li><a class="dropdown-item" href="/Director/BandejaVulnerabilidades"><i class="bi bi-inbox-fill me-2"></i>Bandeja de Vulnerabilidades</a></li>
                                <li><a class="dropdown-item" href="/Director/MonitorGeneral"><i class="bi bi-graph-up-arrow me-2"></i>Monitor Divisional</a></li>
                            </ul>
                        </li>
                    </ul>

                    <div class="d-flex align-items-center gap-2">
                        @if (User.IsInRole("Secretaria") || Context.Request.Path.Value?.Contains("Secretaria", StringComparison.OrdinalIgnoreCase) == true)
                        {
                            <button type="button" class="btn btn-outline-light btn-sm fw-bold" data-bs-toggle="modal" data-bs-target="#modalRegistrarUsuario">
                                <i class="bi bi-person-plus-fill me-1"></i> Registrar Usuario
                            </button>
                        }
                        <button type="button" class="btn btn-warning btn-sm text-dark fw-bold shadow-sm" data-bs-toggle="modal" data-bs-target="#modalCambiarPassword">
                            <i class="bi bi-key-fill me-1"></i> Cambiar Contraseña
                        </button>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <!-- Main Body Container -->
    <main role="main" class="pb-5">
        @RenderBody()
    </main>

    <!-- Modal Registrar Usuario (Secretaría / Director) -->
    <div class="modal fade" id="modalRegistrarUsuario" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-header bg-dark text-white py-3">
                    <h5 class="modal-title fw-bold">
                        <i class="bi bi-person-plus-fill text-success me-2"></i>Registrar Nuevo Usuario UTTT
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form asp-controller="Secretaria" asp-action="RegistrarUsuario" method="post">
                    <div class="modal-body p-4">
                        <div class="mb-3">
                            <label class="form-label fw-bold small text-muted">Nombre Completo</label>
                            <input type="text" name="NombreCompleto" class="form-control" placeholder="Ej. Alan Santiago Molina" required />
                        </div>
                        <div class="row g-2 mb-3">
                            <div class="col-md-6">
                                <label class="form-label fw-bold small text-muted">Correo Institucional</label>
                                <input type="email" name="CorreoElectronico" class="form-control" placeholder="usuario@uttt.edu.mx" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold small text-muted">Matrícula / Num. Empleado</label>
                                <input type="text" name="MatriculaEmpleado" class="form-control" placeholder="23301133" required />
                            </div>
                        </div>
                        <div class="row g-2 mb-3">
                            <div class="col-md-6">
                                <label class="form-label fw-bold small text-muted">Rol Asignado</label>
                                <select name="NombreRol" class="form-select fw-bold border-primary" required>
                                    <option value="Estudiante">Estudiante</option>
                                    <option value="Docente">Docente</option>
                                    <option value="Tutor">Tutor</option>
                                    <option value="Secretaria">Secretaría</option>
                                    <option value="Director">Director</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold small text-muted">Grupo (si aplica)</label>
                                <input type="text" name="NombreGrupo" class="form-control" value="9IDGS-G2" />
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold small text-muted">Contraseña Inicial por Defecto</label>
                            <input type="text" name="ContrasenaInicial" class="form-control bg-light fw-bold text-primary" value="123456" />
                            <small class="text-muted" style="font-size: 0.75rem;">El usuario podrá modificar su contraseña al iniciar sesión.</small>
                        </div>
                    </div>
                    <div class="modal-footer bg-light">
                        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-success btn-sm fw-bold px-4">
                            <i class="bi bi-check-circle me-1"></i> Registrar en Sistema
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Modal Cambiar Contraseña (Autogestión Usuario) -->
    <div class="modal fade" id="modalCambiarPassword" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-header bg-warning text-dark py-3">
                    <h5 class="modal-title fw-bold">
                        <i class="bi bi-shield-lock-fill me-2"></i>Cambiar Contraseña
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form asp-controller="Auth" asp-action="CambiarPassword" method="post">
                    <div class="modal-body p-4">
                        <div class="mb-3">
                            <label class="form-label fw-bold small text-muted">Correo Institucional</label>
                            <input type="email" name="Correo" class="form-control" value="docente@uttt.edu.mx" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold small text-muted">Contraseña Actual</label>
                            <input type="password" name="ContrasenaActual" class="form-control" placeholder="••••••••" required />
                        </div>
                        <div class="row g-2 mb-2">
                            <div class="col-md-6">
                                <label class="form-label fw-bold small text-muted">Nueva Contraseña</label>
                                <input type="password" name="NuevaContrasena" class="form-control" placeholder="Mínimo 6 caract." required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold small text-muted">Confirmar Nueva Contraseña</label>
                                <input type="password" name="ConfirmarContrasena" class="form-control" placeholder="Confirmar" required />
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer bg-light">
                        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-warning btn-sm text-dark fw-bold px-4">
                            <i class="bi bi-arrow-repeat me-1"></i> Actualizar Contraseña
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Footer Institucional UTTT -->
    <footer class="footer-uttt py-4 mt-auto">
        <div class="container text-center">
            <div class="row align-items-center">
                <div class="col-md-6 text-md-start mb-2 mb-md-0">
                    <span class="fw-bold text-white">UNIVERSIDAD TECNOLÓGICA DE TULA-TEPEJI</span>
                    <p class="small mb-0 text-white-50">Ecosistema A.U.R.A. — Control de Asistencias y Registro Académico</p>
                </div>
                <div class="col-md-6 text-md-end small text-white-50">
                    <span>© 2026 UTTT. Todos los derechos reservados.</span>
                </div>
            </div>
        </div>
    </footer>

    <!-- Bootstrap 5 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
