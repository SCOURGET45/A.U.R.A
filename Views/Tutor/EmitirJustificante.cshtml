@model Aura.Models.EmitirJustificanteViewModel

@{
    ViewData["Title"] = "Emitir Justificante - Tutor";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <h3 class="fw-bold text-dark mb-0">
                    <i class="bi bi-file-earmark-plus-fill text-primary me-2"></i>Emitir Justificante Institucional
                </h3>
                <a asp-action="MisTutorados" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-arrow-left me-1"></i> Volver a Tutorados
                </a>
            </div>

            <!-- Resumen del Alumno & Bolsa actual -->
            <div class="card border-0 shadow-sm mb-4 bg-light">
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col-md-6 mb-3 mb-md-0">
                            <h5 class="fw-bold mb-1 text-dark">@Model.NombreEstudiante</h5>
                            <span class="badge bg-dark"><i class="bi bi-person-badge me-1"></i>@Model.MatriculaEstudiante</span>
                        </div>
                        <div class="col-md-6">
                            <div class="d-flex justify-content-around text-center border-start ps-md-3">
                                <div>
                                    <small class="text-muted d-block fw-semibold">Bolsa Justificantes</small>
                                    <span class="fs-4 fw-bold @(Model.JustificantesPreviosCount >= 2 ? "text-danger" : "text-primary")">
                                        @Model.JustificantesPreviosCount / 2
                                    </span>
                                </div>
                                <div>
                                    <small class="text-muted d-block fw-semibold">Días Amparados</small>
                                    <span class="fs-4 fw-bold @(Model.DiasAmparadosPreviosCount >= 15 ? "text-danger" : "text-info")">
                                        @Model.DiasAmparadosPreviosCount / 15
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Formulario de Emisión -->
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-dark text-white py-3">
                    <h5 class="mb-0 fw-semibold"><i class="bi bi-card-checklist me-2"></i>Datos del Justificante</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="EmitirJustificante" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert"></div>

                        <input type="hidden" asp-for="IdEstudiante" />
                        <input type="hidden" asp-for="NombreEstudiante" />
                        <input type="hidden" asp-for="MatriculaEstudiante" />
                        <input type="hidden" asp-for="JustificantesPreviosCount" />
                        <input type="hidden" asp-for="DiasAmparadosPreviosCount" />

                        <!-- Días a amparar -->
                        <div class="mb-4">
                            <label asp-for="DiasAmparados" class="form-label fw-bold text-dark">
                                Días a Amparar <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-calendar-event"></i></span>
                                <input asp-for="DiasAmparados" type="number" class="form-control form-control-lg" min="1" max="15" required />
                                <span class="input-group-text bg-light">día(s)</span>
                            </div>
                            <span asp-validation-for="DiasAmparados" class="text-danger small"></span>
                            <small class="form-text text-muted">
                                Días amparables restantes para este alumno: <strong>@(15 - Model.DiasAmparadosPreviosCount) día(s)</strong>.
                            </small>
                        </div>

                        <!-- Motivo / Diagnóstico -->
                        <div class="mb-4">
                            <label asp-for="Motivo" class="form-label fw-bold text-dark">
                                Motivo o Diagnóstico Médico <span class="text-danger">*</span>
                            </label>
                            <textarea asp-for="Motivo" class="form-control" rows="4" placeholder="Escribe detalladamente la causa de la inasistencia (mínimo 10 caracteres)..." required></textarea>
                            <span asp-validation-for="Motivo" class="text-danger small"></span>
                        </div>

                        <!-- Reglas de Negocio Informativas -->
                        <div class="alert alert-info border-0 shadow-sm d-flex align-items-center mb-4">
                            <i class="bi bi-shield-lock-fill fs-3 me-3 text-info"></i>
                            <div class="small">
                                <strong>Reglas de Negocio A.U.R.A.:</strong> Al emitir este justificante, la inasistencia del alumno quedará justificada y sincronizada automáticamente con la lista de todos los docentes involucrados.
                            </div>
                        </div>

                        <!-- Botones de Acción -->
                        <div class="d-flex justify-content-end gap-2">
                            <a asp-action="MisTutorados" class="btn btn-outline-secondary">Cancelar</a>
                            <button type="submit" class="btn btn-primary px-4 fw-bold">
                                <i class="bi bi-check-circle me-1"></i> Emitir Justificante
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
