@model IEnumerable<Aura.Models.MisTutoradosViewModel>

@{
    ViewData["Title"] = "Mis Tutorados - Tutor";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">
                <i class="bi bi-people-fill text-primary me-2"></i>Gestión de Tutorados
            </h2>
            <p class="text-muted mb-0">Monitorea el riesgo de deserción, emite justificantes e inicia trámites de vulnerabilidad.</p>
        </div>
        <span class="badge bg-primary fs-6 px-3 py-2">
            <i class="bi bi-person-check me-1"></i> @Model.Count() Tutorados Asignados
        </span>
    </div>

    @if (TempData["Exito"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2 fs-5"></i> @TempData["Exito"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-4">
        @foreach (var alumno in Model)
        {
            string borderCardColor = alumno.AsistenciaGlobal < 80 ? "border-danger" : (alumno.TieneSolicitudEnProceso ? "border-warning" : "border-primary");

            <div class="col-md-6 col-lg-4">
                <div class="card h-100 border-0 shadow-sm border-top border-4 @borderCardColor card-hover">
                    <div class="card-body">
                        <!-- Header Alumno -->
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div>
                                <h5 class="card-title fw-bold text-dark mb-1">@alumno.NombreCompleto</h5>
                                <span class="badge bg-light text-secondary border"><i class="bi bi-person-badge me-1"></i>@alumno.Matricula</span>
                            </div>
                            <span class="badge @(alumno.AsistenciaGlobal >= 90 ? "bg-success" : alumno.AsistenciaGlobal >= 80 ? "bg-warning text-dark" : "bg-danger") px-2 py-1">
                                @alumno.AsistenciaGlobal% Asist.
                            </span>
                        </div>

                        <hr class="my-2 text-muted opacity-25" />

                        <!-- Indicadores Bolsa & Días -->
                        <div class="row g-2 text-center my-3">
                            <div class="col-6">
                                <div class="p-2 rounded bg-light border">
                                    <small class="text-muted d-block fw-semibold" style="font-size: 0.75rem;">Justificantes</small>
                                    <span class="fw-bold fs-6 @(alumno.JustificantesUsados >= 2 ? "text-danger" : "text-primary")">
                                        @alumno.JustificantesUsados / @alumno.JustificantesMaximos
                                    </span>
                                    <small class="text-muted d-block" style="font-size: 0.7rem;">emitidos</small>
                                </div>
                            </div>

                            <div class="col-6">
                                <div class="p-2 rounded bg-light border">
                                    <small class="text-muted d-block fw-semibold" style="font-size: 0.75rem;">Días Enferm.</small>
                                    <span class="fw-bold fs-6 @(alumno.DiasAmparadosTotales >= 15 ? "text-danger" : "text-info")">
                                        @alumno.DiasAmparadosTotales / @alumno.DiasAmparadosMaximos
                                    </span>
                                    <small class="text-muted d-block" style="font-size: 0.7rem;">días amparados</small>
                                </div>
                            </div>
                        </div>

                        <!-- Estatus de Vulnerabilidad & Notificaciones -->
                        @if (alumno.FechaJuntaComision.HasValue)
                        {
                            <div class="alert alert-info p-2 mb-2 small border-0 bg-info bg-opacity-10 text-info-emphasis rounded">
                                <i class="bi bi-calendar-event-fill me-1"></i>
                                <strong>Junta Agendada:</strong> @alumno.FechaJuntaComision.Value.ToString("dd/MM/yyyy HH:mm") hrs.
                            </div>
                        }

                        @if (alumno.TieneSolicitudEnProceso)
                        {
                            <div class="alert alert-warning p-2 mb-2 small border-0 bg-warning bg-opacity-10 text-warning-emphasis rounded">
                                <i class="bi bi-hourglass-split me-1"></i>
                                <strong>Vulnerabilidad:</strong> Trámite en revisión por Dirección.
                            </div>
                        }
                        else if (!string.IsNullOrEmpty(alumno.DictamenFinal))
                        {
                            string dictamenColor = alumno.DictamenFinal.Equals("Aprobado", StringComparison.OrdinalIgnoreCase) ? "bg-success" : "bg-secondary";
                            <div class="small text-muted mb-2">
                                Dictamen previo: <span class="badge @dictamenColor">@alumno.DictamenFinal</span>
                            </div>
                        }
                    </div>

                    <!-- Card Actions -->
                    <div class="card-footer bg-transparent border-top-0 pt-0 pb-3">
                        <div class="d-grid gap-2">
                            @if (alumno.JustificantesUsados < 2)
                            {
                                <a asp-action="EmitirJustificante" asp-route-idEstudiante="@alumno.IdEstudiante" class="btn btn-outline-primary btn-sm fw-bold">
                                    <i class="bi bi-file-earmark-plus me-1"></i> Emitir Justificante
                                </a>
                            }
                            else
                            {
                                <button class="btn btn-light btn-sm text-muted border" disabled title="Alumno alcanzó el límite de 2 justificantes por cuatrimestre">
                                    <i class="bi bi-slash-circle me-1"></i> Límite de Justificantes (2/2)
                                </button>
                            }

                            @if (!alumno.TieneSolicitudEnProceso)
                            {
                                <a asp-action="SolicitarVulnerabilidad" asp-route-idEstudiante="@alumno.IdEstudiante" class="btn btn-outline-danger btn-sm">
                                    <i class="bi bi-shield-plus me-1"></i> Solicitar Vulnerabilidad
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<style>
    .card-hover {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .card-hover:hover {
        transform: translateY(-3px);
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.12) !important;
    }
</style>
