@{
    ViewData["Title"] = "F-DC-02/R5 Control de Asistencias y Evaluaciones - UTTT";
    var alumnos = ViewBag.Alumnos as List<Aura.Controllers.AlumnoMonitorDto> ?? new List<Aura.Controllers.AlumnoMonitorDto>();
    var historial = ViewBag.Historial as Dictionary<string, string> ?? new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
}

<style>
    @@media print {
        header, footer, .navbar, .no-print {
            display: none !important;
        }
        body {
            background-color: #fff !important;
            padding: 0 !important;
            margin: 0 !important;
        }
        .container-print {
            width: 100% !important;
            max-width: 100% !important;
            padding: 0 !important;
        }
        .table-report {
            font-size: 8px !important;
        }
    }

    .report-card {
        background-color: #ffffff;
        border: 1px solid #cbd5e1;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
        padding: 30px;
    }

    .table-report {
        font-size: 10.5px;
        border-collapse: collapse;
        width: 100%;
    }

    .table-report th, .table-report td {
        border: 1px solid #000000 !important;
        padding: 3px 4px;
        text-align: center;
        vertical-align: middle;
    }

    .table-report th {
        background-color: #f8fafc;
        font-weight: 700;
    }

    .table-report td.text-start {
        text-align: left !important;
    }
</style>

<div class="container py-4 container-print">
    <!-- Action Bar -->
    <div class="d-flex justify-content-between align-items-center mb-4 no-print">
        <div>
            <h3 class="fw-bold text-dark mb-1">
                <i class="bi bi-file-earmark-spreadsheet-fill text-success me-2"></i>Reporte Oficial UTTT F-DC-02/R5
            </h3>
            <p class="text-muted mb-0">Sábana Institucional de Control de Asistencias y Evaluaciones por Grupo y Asignatura.</p>
        </div>
        <div class="d-flex gap-2">
            <a href="/Docente/DescargarReporteExcel?grupo=@(ViewBag.Grupo ?? "9IDGS-G2")" class="btn btn-success fw-bold">
                <i class="bi bi-file-earmark-excel-fill me-1"></i> Descargar Excel (ClosedXML)
            </a>
            <button type="button" class="btn btn-primary fw-bold" onclick="window.print()">
                <i class="bi bi-printer-fill me-1"></i> Imprimir / Guardar PDF
            </button>
            <a href="/Docente/MiDia" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i> Volver a Mi Día
            </a>
        </div>
    </div>

    <!-- Report Canvas / Sheet -->
    <div class="report-card">
        <!-- Header UTTT -->
        <div class="row align-items-center mb-3">
            <div class="col-3 text-start">
                <div class="d-flex align-items-center gap-2">
                    <div class="bg-dark text-white fw-bold rounded-circle d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                        <span class="fs-4 text-warning">UT</span>
                    </div>
                    <div>
                        <strong class="d-block leading-tight text-success" style="font-size: 0.95rem;">Universidad Tecnológica de Tula-Tepeji</strong>
                        <small class="text-muted" style="font-size: 0.7rem;">A.U.R.A. Ecosistema Académico</small>
                    </div>
                </div>
            </div>
            <div class="col-6 text-center">
                <h5 class="fw-bold text-dark mb-0 text-uppercase tracking-wide" style="font-size: 1.1rem; border-bottom: 2px solid #000; display: inline-block; padding-bottom: 2px;">
                    CONTROL DE ASISTENCIAS Y EVALUACIONES
                </h5>
            </div>
            <div class="col-3 text-end" style="font-size: 0.72rem; leading-tight;">
                <strong>Universidad Tecnológica de Tula-Tepeji</strong><br />
                Organismo Público Descentralizado<br />
                del Gobierno del Estado de Hidalgo
            </div>
        </div>

        <!-- Metadata Block -->
        <div class="row g-2 mb-3" style="font-size: 0.82rem; font-weight: 600;">
            <div class="col-8">
                <div><span class="fw-bold">Programa Educativo :</span> TECNOLOGÍAS DE LA INFORMACIÓN, INGENIERÍA EN DESARROLLO Y GESTIÓN DE SOFTWARE</div>
                <div><span class="fw-bold">Asignatura :</span> @(ViewBag.Asignatura ?? "ADMINISTRACIÓN DE PROYECTOS DE TI")</div>
                <div><span class="fw-bold">Cuatrimestre :</span> NOVENO CUATRIMESTRE</div>
                <div><span class="fw-bold">Docente :</span> Odisey Yasmin Porras Beltrán</div>
            </div>
            <div class="col-4 text-end">
                <div><span class="fw-bold">Grupo :</span> <span class="fs-6 fw-bold text-primary">@(ViewBag.Grupo ?? "9IDGS-G2")</span></div>
                <div><span class="fw-bold">Periodo :</span> MAYO - AGOSTO 2026</div>
            </div>
        </div>

        <!-- Weekly Matrix Table -->
        <div class="table-responsive">
            <table class="table-report">
                <thead>
                    <tr>
                        <th rowspan="3" style="width: 25px;">#</th>
                        <th rowspan="3" style="width: 220px;" class="text-start ps-2">Nombre del Alumno</th>
                        <th colspan="4">Semana 1</th>
                        <th colspan="4">Semana 2</th>
                        <th colspan="4">Semana 3</th>
                        <th colspan="4">Semana 4</th>
                        <th colspan="4">Semana 5</th>
                        <th rowspan="3" style="width: 25px;">TC</th>
                        <th rowspan="3" style="width: 25px;">TA</th>
                        <th rowspan="3" style="width: 25px;">TF</th>
                        <th rowspan="3" style="width: 35px;">% As</th>
                    </tr>
                    <tr>
                        <th>Lu</th><th>Ma</th><th>Mi</th><th>Ju</th>
                        <th>Lu</th><th>Ma</th><th>Mi</th><th>Ju</th>
                        <th>Lu</th><th>Ma</th><th>Mi</th><th>Ju</th>
                        <th>Lu</th><th>Ma</th><th>Mi</th><th>Ju</th>
                        <th>Lu</th><th>Ma</th><th>Mi</th><th>Ju</th>
                    </tr>
                    <tr>
                        <th>04</th><th>05</th><th>06</th><th>07</th>
                        <th>11</th><th>12</th><th>13</th><th>14</th>
                        <th>18</th><th>19</th><th>20</th><th>21</th>
                        <th>25</th><th>26</th><th>27</th><th>28</th>
                        <th>01</th><th>02</th><th>03</th><th>04</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int idx = 1;
                    }

                    @foreach (var alumno in alumnos)
                    {
                        string cleanMat = alumno.Matricula.Split('@')[0].Trim();

                        int tc = 20;
                        int ta = 0;
                        int tf = 0;

                        <tr id="row-alumno-@alumno.Matricula">
                            <td class="fw-bold">@idx</td>
                            <td class="text-start ps-2 fw-semibold">
                                @alumno.NombreCompleto
                                <br /><small class="text-muted fw-normal" style="font-size: 0.7rem;">Matrícula: @cleanMat</small>
                            </td>

                            @for (int sem = 1; sem <= 5; sem++)
                            {
                                for (int dia = 1; dia <= 4; dia++)
                                {
                                    string key = $"{cleanMat}_S{sem}_D{dia}";
                                    string marca = "";

                                    if (historial.ContainsKey(key))
                                    {
                                        marca = historial[key];
                                        tc++;
                                        if (marca == "." || marca == "+=" || marca == "X") { ta++; }
                                        else if (marca == "/") { tf++; }
                                    }

                                    string celdaBg = marca == "/" ? "bg-danger bg-opacity-25 text-danger fw-bold" : (marca == "X" ? "bg-warning bg-opacity-25 text-dark fw-bold" : (marca == "+=" ? "bg-info bg-opacity-25 text-info fw-bold" : (marca == "." ? "text-dark fw-bold" : "")));

                                    <td class="@celdaBg">@marca</td>
                                }
                            }

                            @{
                                double pct = tc > 0 ? Math.Round(((double)ta / tc) * 100, 1) : 100.0;
                                bool esRiesgo = tc > 0 && pct < 80;
                            }

                            <!-- Totales -->
                            <td class="fw-bold">@tc</td>
                            <td class="fw-bold text-success">@ta</td>
                            <td class="fw-bold @(tf > 3 ? "text-danger" : "text-muted")">@tf</td>
                            <td class="fw-bold @(esRiesgo ? "text-danger bg-danger bg-opacity-10" : "text-dark")">@pct%</td>
                        </tr>
                        idx++;
                    }
                </tbody>
            </table>
        </div>

        <!-- Simbología y Footer Institucional -->
        <div class="row align-items-end mt-4 pt-2 border-top border-dark" style="font-size: 0.78rem;">
            <div class="col-8">
                <div class="fw-bold mb-1">Simbología</div>
                <div class="d-flex flex-wrap gap-4">
                    <span><strong>.</strong> = Asistencia</span>
                    <span><strong>/</strong> = falta</span>
                    <span><strong>+=</strong> = Falta justificada</span>
                    <span><strong>X</strong> = Retardo</span>
                </div>
                <div class="d-flex flex-wrap gap-4 mt-1">
                    <span><strong>TC</strong> = Total de clases</span>
                    <span><strong>TA</strong> = Total asistencia</span>
                    <span><strong>TF</strong> = Total faltas</span>
                </div>
            </div>
            <div class="col-4 text-end fw-bold">
                F-DC-02/R5<br />
                <span class="fw-normal text-muted" style="font-size: 0.7rem;">Septiembre 02, 2015</span>
            </div>
        </div>
    </div>
</div>
