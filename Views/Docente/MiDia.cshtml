@model Aura.Models.DocenteMiDiaViewModel

@{
    ViewData["Title"] = "Mi Día - Pase de Lista en Tiempo Real - UTTT";
    string primerGrupo = Model.Clases.FirstOrDefault()?.Grupo ?? "9IDGS-G2";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">
                <i class="bi bi-broadcast-pin text-primary me-2"></i>Agenda y Pase de Lista en Vivo
            </h2>
            <p class="text-muted mb-0">Emisión ultrasónica de 19.5 kHz y asentamiento automático en el reporte oficial F-DC-02/R5.</p>
        </div>
        <span class="badge bg-dark fs-6 px-3 py-2 shadow-sm">
            <i class="bi bi-calendar-event me-1"></i> @Model.FechaActual.ToString("dddd, dd de MMMM de yyyy")
        </span>
    </div>

    @if (TempData["Exito"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2 fs-5"></i> @TempData["Exito"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Selector de Día y Semana de Captura -->
    <div class="card border-0 shadow-sm mb-4 bg-light">
        <div class="card-body p-3">
            <form asp-controller="Docente" asp-action="FinalizarPaseLista" method="post" class="row align-items-center g-3">
                <input type="hidden" name="grupo" id="hiddenGrupoFinalizar" value="@primerGrupo" />
                <div class="col-md-3">
                    <label class="form-label fw-bold small text-muted mb-1"><i class="bi bi-calendar3 me-1"></i>Semana del Cuatrimestre</label>
                    <select name="semana" class="form-select fw-bold border-primary" required>
                        <option value="1">Semana 1</option>
                        <option value="2">Semana 2</option>
                        <option value="3">Semana 3</option>
                        <option value="4">Semana 4</option>
                        <option value="5">Semana 5</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-bold small text-muted mb-1"><i class="bi bi-clock-history me-1"></i>Día de Impartición</label>
                    <select name="diaSemana" class="form-select fw-bold border-primary" required>
                        <option value="1">Lunes (Día 1)</option>
                        <option value="2">Martes (Día 2)</option>
                        <option value="3">Miércoles (Día 3)</option>
                        <option value="4">Jueves (Día 4)</option>
                    </select>
                </div>
                <div class="col-md-6 text-end pt-4">
                    <button type="submit" class="btn btn-primary fw-bold shadow-sm px-4">
                        <i class="bi bi-file-earmark-check-fill me-1"></i> Concluir y Asentar en Reporte F-DC-02/R5
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Cards Clases Hoy -->
    <div class="row mb-4">
        @if (!Model.Clases.Any())
        {
            <div class="col-12 text-center text-muted mt-5">
                <h4><i class="bi bi-cup-hot"></i> No tienes clases asignadas por Secretaría en este momento.</h4>
                <p class="small text-muted">Contacta a la Secretaría de Carrera para la asignación de tus materias y grupos.</p>
            </div>
        }
        else
        {
            @foreach (var clase in Model.Clases)
            {
                string opacidad = clase.EstadoFase == "Completada" ? "opacity-50 bg-light" : "";
                string borde = clase.EstadoFase == "En Curso" ? "border-primary border-2 shadow" : "border-0 shadow-sm";

                <div class="col-md-6 col-lg-6 mb-3">
                    <div class="card h-100 @opacidad @borde">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h5 class="card-title mb-0 text-primary fw-bold">@clase.Grupo</h5>
                                @if (clase.EstadoFase == "En Curso")
                                {
                                    <span class="badge bg-success blink-soft fs-6 px-3 py-1">🟢 EN CURSO</span>
                                }
                            </div>

                            <h6 class="card-subtitle mb-3 text-muted">@clase.Materia</h6>

                            <p class="mb-1 text-success fw-semibold">
                                <i class="bi bi-calendar-check me-1"></i> Sesión Lista para Pase de Lista
                            </p>

                            @if (clase.AlertasVulnerabilidad)
                            {
                                <p class="small text-info mb-3">
                                    <i class="bi bi-shield-check me-1"></i> Alumnos con tolerancia activa reconocidos automáticamente.
                                </p>
                            }
                        </div>

                        <div class="card-footer bg-transparent border-top-0 pb-3">
                            <button class="btn btn-success w-100 fw-bold pulse-btn"
                                    onclick="toggleUltrasonido(this, @clase.IdSesion, '@clase.Grupo')">
                                <i class="bi bi-broadcast me-1"></i> Emitir Tono Ultrasónico (19.5 kHz) - ENCENDER
                            </button>
                        </div>
                    </div>
                </div>
            }
        }
    </div>

    <!-- SECCIÓN MONITOR EN TIEMPO REAL AL MOMENTO -->
    <div class="card border-0 shadow mb-5">
        <div class="card-header bg-dark text-white py-3 d-flex justify-content-between align-items-center">
            <h5 class="mb-0 fw-bold">
                <i class="bi bi-activity text-success me-2"></i>Monitor de Asistencia en Tiempo Real — Grupo <span id="spanNombreGrupoMonitor" class="text-warning">@primerGrupo</span>
            </h5>
            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-success text-white px-3 py-2 fw-bold" id="badgeActualizacion">
                    <i class="bi bi-arrow-repeat me-1 spin-slow"></i> En Vivo (3s)
                </span>
            </div>
        </div>

        <div class="card-body">
            <!-- Tarjetas Resumen al Momento -->
            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <div class="p-3 bg-success bg-opacity-10 border border-success rounded text-center">
                        <small class="text-success text-uppercase fw-bold">Presentes al Momento</small>
                        <h2 class="display-6 fw-bold text-success mb-0" id="cntPresentes">0</h2>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="p-3 bg-info bg-opacity-10 border border-info rounded text-center">
                        <small class="text-info text-uppercase fw-bold">Tolerancia Activa (Director)</small>
                        <h2 class="display-6 fw-bold text-info mb-0" id="cntTolerancia">0</h2>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="p-3 bg-warning bg-opacity-10 border border-warning rounded text-center">
                        <small class="text-dark text-uppercase fw-bold">Pendientes / Sin Escanear</small>
                        <h2 class="display-6 fw-bold text-dark mb-0" id="cntPendientes">0</h2>
                    </div>
                </div>
            </div>

            <!-- Tabla en Vivo de Alumnos -->
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" id="tablaMonitorVivo">
                    <thead class="bg-light">
                        <tr>
                            <th class="ps-3">Matrícula</th>
                            <th>Alumno</th>
                            <th>Estatus en Vivo</th>
                            <th>Hora de Marcado</th>
                            <th>Método de Validación</th>
                            <th class="text-center">Cambio Manual</th>
                        </tr>
                    </thead>
                    <tbody id="tbodyMonitor">
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">
                                <div class="spinner-border spinner-border-sm text-primary me-2" role="status"></div>
                                Cargando lista de asistencia del grupo...
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script>
    let audioCtxDocente = null;
    let osciladorDocente = null;
    let esEmitiendoTono = false;
    let grupoSeleccionado = "@primerGrupo";

    function toggleUltrasonido(botonElemento, idSesion, grupo) {
        if (grupo) {
            grupoSeleccionado = grupo;
            const hiddenInput = document.getElementById('hiddenGrupoFinalizar');
            const spanMonitor = document.getElementById('spanNombreGrupoMonitor');
            if (hiddenInput) hiddenInput.value = grupo;
            if (spanMonitor) spanMonitor.innerText = grupo;
            cargarAsistenciaEnVivo();
        }

        if (!esEmitiendoTono) {
            try {
                audioCtxDocente = new (window.AudioContext || window.webkitAudioContext)();
                osciladorDocente = audioCtxDocente.createOscillator();
                const ganancia = audioCtxDocente.createGain();

                osciladorDocente.type = 'sine';
                osciladorDocente.frequency.value = 19500;

                osciladorDocente.connect(ganancia);
                ganancia.connect(audioCtxDocente.destination);
                osciladorDocente.start();

                esEmitiendoTono = true;
                botonElemento.innerHTML = '<i class="bi bi-stop-circle-fill me-1"></i> DETENER Tono Ultrasónico (19.5 kHz) - APAGAR';
                botonElemento.classList.replace('btn-success', 'btn-danger');
                botonElemento.classList.add('blink-soft');
            } catch (e) {
                console.error("Error al emitir sonido:", e);
            }
        } else {
            try {
                if (osciladorDocente) {
                    osciladorDocente.stop();
                    osciladorDocente.disconnect();
                }
                if (audioCtxDocente) {
                    audioCtxDocente.close();
                }
            } catch (e) { }

            esEmitiendoTono = false;
            botonElemento.innerHTML = '<i class="bi bi-broadcast me-1"></i> Emitir Tono Ultrasónico (19.5 kHz) - ENCENDER';
            botonElemento.classList.replace('btn-danger', 'btn-success');
            botonElemento.classList.remove('blink-soft');
        }
    }

    async function cargarAsistenciaEnVivo() {
        try {
            const resp = await fetch('/api/Asistencia/ObtenerPaseListaGrupo?grupo=' + encodeURIComponent(grupoSeleccionado));
            if (!resp.ok) return;

            const alumnos = await resp.json();
            const tbody = document.getElementById('tbodyMonitor');
            if (!tbody) return;

            let cntPres = 0;
            let cntTol = 0;
            let cntPend = 0;

            let html = '';
            if (alumnos.length === 0) {
                html = '<tr><td colspan="6" class="text-center text-muted py-4"><i class="bi bi-info-circle me-1"></i> No hay alumnos registrados para este grupo.</td></tr>';
            } else {
                alumnos.forEach(a => {
                    let badgeClass = 'bg-secondary';
                    let badgeText = 'PENDIENTE';
                    let icon = 'bi-hourglass-split';

                    if (a.estado === 'PRESENTE') {
                        badgeClass = 'bg-success text-white';
                        badgeText = 'PRESENTE';
                        icon = 'bi-check-circle-fill';
                        cntPres++;
                    } else if (a.estado === 'TOLERANCIA_ACTIVA') {
                        badgeClass = 'bg-info text-dark';
                        badgeText = 'TOLERANCIA ACTIVA (+30m)';
                        icon = 'bi-clock-history';
                        cntTol++;
                    } else if (a.estado === 'RETARDO') {
                        badgeClass = 'bg-warning text-dark';
                        badgeText = 'RETARDO';
                        icon = 'bi-exclamation-triangle-fill';
                        cntPres++;
                    } else {
                        cntPend++;
                    }

                    html += `
                        <tr>
                            <td class="ps-3 fw-bold text-muted">${a.matricula}</td>
                            <td class="fw-bold text-dark">${a.nombreCompleto}</td>
                            <td>
                                <span class="badge ${badgeClass} fs-6 px-3 py-2">
                                    <i class="bi ${icon} me-1"></i> ${badgeText}
                                </span>
                            </td>
                            <td class="fw-semibold text-dark">${a.horaMarcado ? a.horaMarcado : '<span class="text-muted small">Sin marcar</span>'}</td>
                            <td>
                                <span class="badge bg-light text-dark border">
                                    <i class="bi bi-reception-4 text-success me-1"></i> ${a.metodo}
                                </span>
                            </td>
                            <td class="text-center">
                                <button class="btn btn-sm btn-outline-success me-1 fw-bold" onclick="marcarManual('${a.matricula}', 'PRESENTE')">
                                    <i class="bi bi-check-lg"></i> Presente
                                </button>
                                <button class="btn btn-sm btn-outline-warning fw-bold" onclick="marcarManual('${a.matricula}', 'RETARDO')">
                                    <i class="bi bi-clock"></i> Retardo
                                </button>
                            </td>
                        </tr>
                    `;
                });
            }

            tbody.innerHTML = html;
            document.getElementById('cntPresentes').innerText = cntPres;
            document.getElementById('cntTolerancia').innerText = cntTol;
            document.getElementById('cntPendientes').innerText = cntPend;

        } catch (e) {
            console.error("Error al cargar asistencia en vivo:", e);
        }
    }

    async function marcarManual(matricula, nuevoEstado) {
        try {
            await fetch('/api/Asistencia/MarcarAsistenciaManual', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ matricula: matricula, nuevoEstado: nuevoEstado })
            });
            cargarAsistenciaEnVivo();
        } catch (e) {
            console.error("Error al marcar manual:", e);
        }
    }

    document.addEventListener("DOMContentLoaded", () => {
        cargarAsistenciaEnVivo();
        setInterval(cargarAsistenciaEnVivo, 3000);
    });
</script>

<style>
    .blink-soft { animation: blinker 2s linear infinite; }
    @@keyframes blinker { 50% { opacity: 0.5; } }
    .pulse-btn { animation: pulse-uttt 2.5s infinite; }
    @@keyframes pulse-uttt {
        0% { box-shadow: 0 0 0 0 rgba(0, 104, 55, 0.6); }
        70% { box-shadow: 0 0 0 15px rgba(0, 104, 55, 0); }
        100% { box-shadow: 0 0 0 0 rgba(0, 104, 55, 0); }
    }
</style>
