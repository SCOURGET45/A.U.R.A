@model Aura.Models.SecretariaDashboardViewModel

@{
    ViewData["Title"] = "Panel de Secretaría - A.U.R.A.";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">
                <i class="bi bi-building-gear text-primary me-2"></i>Administración Central & Secretaría
            </h2>
            <p class="text-muted mb-0">Gestión masiva y directa de la plantilla cuatrimestral, directorio y tolerancias.</p>
        </div>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-success fw-bold shadow-sm" data-bs-toggle="modal" data-bs-target="#modalEditarAlumno" onclick="prepararNuevoAlumno()">
                <i class="bi bi-person-plus-fill me-1"></i> Agregar Alumno Manualmente
            </button>
            <a asp-action="ConfigurarUnidades" class="btn btn-outline-primary fw-bold">
                <i class="bi bi-gear-wide-connected me-1"></i> Configuración de Unidades
            </a>
            <a asp-action="AlumnosVulnerables" class="btn btn-primary fw-bold">
                <i class="bi bi-shield-lock me-1"></i> Alumnos Vulnerables
            </a>
        </div>
    </div>

    @if (TempData["Exito"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2 fs-5"></i> @TempData["Exito"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Cards KPI Secretaría -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm bg-primary text-white p-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <small class="text-white-50 text-uppercase fw-bold">Alumnos Inscritos</small>
                        <h2 class="display-6 fw-bold mb-0">@Model.TotalAlumnosInscritos</h2>
                    </div>
                    <i class="bi bi-person-lines-fill fs-1 opacity-50"></i>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm bg-dark text-white p-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <small class="text-white-50 text-uppercase fw-bold">Grupos Activos</small>
                        <h2 class="display-6 fw-bold mb-0">@Model.TotalGruposActivos</h2>
                    </div>
                    <i class="bi bi-collection fs-1 opacity-50"></i>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm bg-info text-white p-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <small class="text-white-50 text-uppercase fw-bold">Alumnos Vulnerables</small>
                        <h2 class="display-6 fw-bold mb-0">@Model.TotalAlumnosVulnerables</h2>
                    </div>
                    <i class="bi bi-shield-check fs-1 opacity-50"></i>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm bg-secondary text-white p-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <small class="text-white-50 text-uppercase fw-bold">Materias Config.</small>
                        <h2 class="display-6 fw-bold mb-0">@Model.TotalMateriasConfiguradas</h2>
                    </div>
                    <i class="bi bi-journal-check fs-1 opacity-50"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Sección 1: Carga Masiva & Directorio -->
    <div class="row g-4 mb-4">
        <!-- 5.1 Carga Masiva CSV -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-dark text-white py-3 d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fw-semibold"><i class="bi bi-cloud-upload me-2"></i>Carga Masiva de Alumnos (CSV)</h5>
                    <a asp-controller="Secretaria" asp-action="DescargarPlantillaCSV" class="btn btn-outline-light btn-sm fw-bold">
                        <i class="bi bi-file-earmark-arrow-down me-1"></i> Plantilla CSV
                    </a>
                </div>
                <div class="card-body">
                    <p class="text-muted small">
                        Sube la plantilla oficial en formato <strong>.CSV</strong> al inicio del cuatrimestre.
                        El sistema autodetecta delimitadores por coma (<code>,</code>) o punto y coma (<code>;</code>) de Excel.
                    </p>

                    <form asp-controller="Secretaria" asp-action="CargarAlumnosCSV" method="post" enctype="multipart/form-data">
                        <div class="mb-3">
                            <label class="form-label fw-bold small text-muted">Seleccionar archivo .CSV</label>
                            <input class="form-control" type="file" id="archivoCsv" name="archivoCsv" accept=".csv" required>
                        </div>
                        <div class="alert alert-light border small text-muted mb-3">
                            Columnas esperadas: <code>Matricula, Correo, Nombre, Grupo</code>
                        </div>
                        <button type="submit" class="btn btn-primary w-100 fw-bold">
                            <i class="bi bi-cloud-arrow-up-fill me-1"></i> Procesar e Inscribir Plantilla Masiva
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <!-- 5.1 Directorio Jerárquico Árbol -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-dark text-white py-3">
                    <h5 class="mb-0 fw-semibold"><i class="bi bi-diagram-3 me-2"></i>Directorio Institucional (Árbol)</h5>
                </div>
                <div class="card-body">
                    <p class="text-muted small mb-3">Estructura jerárquica de la División Académica (Drill-Down):</p>

                    <div class="accordion" id="accordionDirectorio">
                        <div class="accordion-item border-0 mb-2 shadow-sm rounded">
                            <h2 class="accordion-header" id="headingOne">
                                <button class="accordion-button fw-bold text-primary bg-light" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne" aria-expanded="true" aria-controls="collapseOne">
                                    <i class="bi bi-laptop me-2"></i> Área: Tecnologías de la Información
                                </button>
                            </h2>
                            <div id="collapseOne" class="accordion-collapse collapse show" aria-labelledby="headingOne" data-bs-parent="#accordionDirectorio">
                                <div class="accordion-body small">
                                    <ul class="list-group list-group-flush">
                                        <li class="list-group-item d-flex justify-content-between align-items-center">
                                            <span><i class="bi bi-folder2-open me-2 text-warning"></i>Noveno Cuatrimestre</span>
                                            <span class="badge bg-primary">Grupo 9IDGS-G2 (28 Alumnos)</span>
                                        </li>
                                        <li class="list-group-item d-flex justify-content-between align-items-center">
                                            <span><i class="bi bi-folder2-open me-2 text-warning"></i>Noveno Cuatrimestre</span>
                                            <span class="badge bg-primary">Grupo 9IDGS-G1 (30 Alumnos)</span>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </div>

                        <div class="accordion-item border-0 shadow-sm rounded">
                            <h2 class="accordion-header" id="headingTwo">
                                <button class="accordion-button collapsed fw-bold text-dark bg-light" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTwo" aria-expanded="false" aria-controls="collapseTwo">
                                    <i class="bi bi-cpu me-2"></i> Área: Mecatrónica y Sistemas Automatizados
                                </button>
                            </h2>
                            <div id="collapseTwo" class="accordion-collapse collapse" aria-labelledby="headingTwo" data-bs-parent="#accordionDirectorio">
                                <div class="accordion-body small">
                                    <ul class="list-group list-group-flush">
                                        <li class="list-group-item d-flex justify-content-between align-items-center">
                                            <span><i class="bi bi-folder2-open me-2 text-warning"></i>Séptimo Cuatrimestre</span>
                                            <span class="badge bg-secondary">Grupo 7MEC-G1 (25 Alumnos)</span>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Sección 2: Edición Directa y Gestor de Alumnos en Pantalla -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-dark text-white py-3 d-flex justify-content-between align-items-center">
            <h5 class="mb-0 fw-semibold">
                <i class="bi bi-table me-2"></i>Edición Directa y Gestor de Alumnos Inscritos
            </h5>
            <button type="button" class="btn btn-sm btn-success fw-bold" data-bs-toggle="modal" data-bs-target="#modalEditarAlumno" onclick="prepararNuevoAlumno()">
                <i class="bi bi-plus-lg me-1"></i> Agregar Registro
            </button>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="ps-3">Matrícula</th>
                            <th>Nombre(s)</th>
                            <th>Apellidos</th>
                            <th>Grupo</th>
                            <th class="text-center">Acciones en Pantalla</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var alumno in Model.AlumnosRegistrados)
                        {
                            <tr>
                                <td class="ps-3 fw-bold text-primary">@alumno.Matricula</td>
                                <td class="fw-bold text-dark">@alumno.Nombre</td>
                                <td>@alumno.Apellidos</td>
                                <td><span class="badge bg-light text-dark border">@alumno.NombreGrupo</span></td>
                                <td class="text-center">
                                    <div class="d-flex justify-content-center gap-1">
                                        <button type="button" class="btn btn-sm btn-outline-primary" 
                                                onclick="cargarDatosEdicion(@alumno.IdEstudiante, '@alumno.Matricula', '@alumno.Nombre', '@alumno.Apellidos', '@alumno.NombreGrupo')">
                                            <i class="bi bi-pencil-square me-1"></i> Editar
                                        </button>
                                        <form asp-controller="Secretaria" asp-action="EliminarAlumno" method="post" class="d-inline" onsubmit="return confirm('¿Seguro que deseas eliminar a @alumno.Nombre @alumno.Apellidos?');">
                                            <input type="hidden" name="idEstudiante" value="@alumno.IdEstudiante" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Eliminar registro">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- 5.2 Panel de Alumnos Vulnerables (Solo Lectura) -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-dark text-white py-3 d-flex justify-content-between align-items-center">
            <h5 class="mb-0 fw-semibold"><i class="bi bi-shield-check me-2"></i>Panel Consolidado de Alumnos Vulnerables (Solo Lectura)</h5>
            <span class="badge bg-info text-dark">Banderas de Tolerancia Activas</span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="ps-3">Matrícula</th>
                            <th>Alumno</th>
                            <th>Grupo</th>
                            <th>Tutor Responsable</th>
                            <th>Motivo Vulnerabilidad</th>
                            <th class="text-center">Tolerancia Otorgada</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var alumno in Model.AlumnosVulnerables)
                        {
                            <tr>
                                <td class="ps-3 fw-bold text-muted">@alumno.Matricula</td>
                                <td class="fw-bold text-dark">@alumno.NombreCompleto</td>
                                <td><span class="badge bg-light text-dark border">@alumno.NombreGrupo</span></td>
                                <td>@alumno.NombreTutor</td>
                                <td><span class="badge bg-info text-dark">@alumno.Motivo</span></td>
                                <td class="text-center">
                                    <span class="badge bg-success px-3 py-2 fs-6">
                                        <i class="bi bi-clock-history me-1"></i> +@alumno.MinutosTolerancia min.
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal Edición / Adición Manual de Alumno -->
<div class="modal fade" id="modalEditarAlumno" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form asp-controller="Secretaria" asp-action="GuardarAlumno" method="post">
                <div class="modal-header bg-primary text-white py-3">
                    <h5 class="modal-title fw-bold" id="modalAlumnoTitulo">
                        <i class="bi bi-person-lines-fill me-2"></i>Gestor de Alumno
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <input type="hidden" id="editIdEstudiante" name="IdEstudiante" value="0" />

                    <div class="mb-3">
                        <label for="editMatricula" class="form-label fw-bold small text-muted">Matrícula UTTT <span class="text-danger">*</span></label>
                        <input type="text" id="editMatricula" name="Matricula" class="form-control form-control-lg" placeholder="Ej. 23301133" required />
                    </div>

                    <div class="mb-3">
                        <label for="editNombre" class="form-label fw-bold small text-muted">Nombre(s) <span class="text-danger">*</span></label>
                        <input type="text" id="editNombre" name="Nombre" class="form-control" placeholder="Ej. Alan Santiago" required />
                    </div>

                    <div class="mb-3">
                        <label for="editApellidos" class="form-label fw-bold small text-muted">Apellidos <span class="text-danger">*</span></label>
                        <input type="text" id="editApellidos" name="Apellidos" class="form-control" placeholder="Ej. Molina" required />
                    </div>

                    <div class="mb-3">
                        <label for="editNombreGrupo" class="form-label fw-bold small text-muted">Grupo Asignado <span class="text-danger">*</span></label>
                        <input type="text" id="editNombreGrupo" name="NombreGrupo" class="form-control" placeholder="Ej. 9IDGS-G2" required />
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary fw-bold px-4">
                        <i class="bi bi-save me-1"></i> Guardar Cambios
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function prepararNuevoAlumno() {
        document.getElementById('editIdEstudiante').value = "0";
        document.getElementById('editMatricula').value = "";
        document.getElementById('editNombre').value = "";
        document.getElementById('editApellidos').value = "";
        document.getElementById('editNombreGrupo').value = "9IDGS-G2";
        document.getElementById('modalAlumnoTitulo').innerHTML = '<i class="bi bi-person-plus-fill me-2"></i>Agregar Alumno Manualmente';
    }

    function cargarDatosEdicion(id, matricula, nombre, apellidos, grupo) {
        document.getElementById('editIdEstudiante').value = id;
        document.getElementById('editMatricula').value = matricula;
        document.getElementById('editNombre').value = nombre;
        document.getElementById('editApellidos').value = apellidos;
        document.getElementById('editNombreGrupo').value = grupo;
        document.getElementById('modalAlumnoTitulo').innerHTML = '<i class="bi bi-pencil-square me-2"></i>Editar Datos del Alumno';
        
        var modal = new bootstrap.Modal(document.getElementById('modalEditarAlumno'));
        modal.show();
    }
</script>
